# Sao chép file này thành .env (KHÔNG commit .env thật) rồi điền giá trị thật khi deploy.
# Ở môi trường dev, mọi biến dưới đây đều có giá trị mặc định an toàn để chạy ngay — chỉ BẮT BUỘC phải set
# khi NODE_ENV=production (app sẽ throw lỗi rõ ràng lúc khởi động nếu thiếu).

NODE_ENV=development

# MongoDB — phải là replica set (bắt buộc cho transaction)
MONGODB_URI=mongodb://localhost:27017/so_chu_nhiem?replicaSet=rs0

PORT=3001

# Danh sách origin được phép gọi CORS, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3000

# Bắt buộc phải set (và phải là 2 giá trị khác nhau, đủ dài/ngẫu nhiên) khi NODE_ENV=production
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
